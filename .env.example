# Copia este archivo a .env y ajusta los valores para producción.

# Secreto para firmar los JWT. OBLIGATORIO en producción.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origen permitido para CORS (el frontend).
CLIENT_ORIGIN=http://localhost:5180

# Puerto de la API.
PORT=4000
